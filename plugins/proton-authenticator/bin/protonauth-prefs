#!/usr/bin/env python3
from __future__ import annotations

import json
import sys

sys.dont_write_bytecode = True

import protonauth_state as state

MAX_BYTES = 256 * 1024
MAX_KEYS = 2000
MAX_KEY_CHARS = 300
EMPTY = {"pins": {}, "used": {}}

def clean(data: object) -> dict:

    out = {"pins": {}, "used": {}}
    if not isinstance(data, dict):
        return out
    pins, used = data.get("pins"), data.get("used")
    if isinstance(pins, dict):
        for k, v in list(pins.items())[:MAX_KEYS]:
            if isinstance(k, str) and 0 < len(k) <= MAX_KEY_CHARS and v is True:
                out["pins"][k] = True
    if isinstance(used, dict):
        for k, v in list(used.items())[:MAX_KEYS]:
            if (isinstance(k, str) and 0 < len(k) <= MAX_KEY_CHARS
                    and isinstance(v, int) and not isinstance(v, bool) and 0 <= v < 2**41):
                out["used"][k] = v
    return out

def read() -> dict:
    d = state.state_dir(create=False)
    if d is None:
        return dict(EMPTY)
    raw = state.read_private(d, "prefs.json", MAX_BYTES)
    if raw is None:
        return dict(EMPTY)
    try:
        return clean(json.loads(raw))
    except ValueError:
        return dict(EMPTY)

def write(raw: bytes) -> None:
    if len(raw) > MAX_BYTES:
        raise SystemExit("prefs too large")
    data = clean(json.loads(raw))
    payload = json.dumps(data, separators=(",", ":")) + "\n"
    state.atomic_write(state.ensure_state_dir(), "prefs.json", payload.encode())

def main() -> int:
    cmd = sys.argv[1] if len(sys.argv) == 2 else ""
    if cmd == "read":
        print(json.dumps(read(), separators=(",", ":")))
        return 0
    if cmd == "write":
        write(sys.stdin.buffer.read(MAX_BYTES + 1))
        return 0
    print("usage: protonauth-prefs read|write", file=sys.stderr)
    return 2

if __name__ == "__main__":
    sys.exit(main())
