#!/bin/sh
set -u
LC_ALL=C
export LC_ALL

WL_PASTE=/usr/bin/wl-paste
HEAD=/usr/bin/head
TIMEOUT=/usr/bin/timeout
OD=/usr/bin/od
TR=/usr/bin/tr

nomatch() {
  printf 'nomatch\n'
  exit 0
}

hex() { "$OD" -An -v -tx1 | "$TR" -d ' \n'; }

want=$("$HEAD" -c 11)
case $want in
  '' | *[!0-9]*) nomatch ;;
  *) ;;
esac
[ "${#want}" -le 10 ] || nomatch

limit=$((${#want} + 1))
got=$("$TIMEOUT" -k 1 2 "$WL_PASTE" --no-newline --type text 2>/dev/null | "$HEAD" -c "$limit" | hex)
expected=$(printf '%s' "$want" | hex)

if [ -n "$got" ] && [ "$got" = "$expected" ]; then
  printf 'match\n'
else
  nomatch
fi
