#!/usr/bin/python3
from __future__ import annotations

import ctypes
import ctypes.util
import hashlib
import hmac
import json
import os
import secrets
import stat
import sys
import tempfile
import time
from pathlib import Path

APP_ID = "proton-authenticator"
MIN_LEN, MAX_LEN = 6, 128
N, R, P = 2**15, 8, 1
DELAYS = [30, 60, 300, 900]
SESSION_TTL = 300
PAM_SERVICE = "login"

def state_dir(create: bool) -> Path | None:
    xdg = os.environ.get("XDG_STATE_HOME", "")
    d = (Path(xdg) if xdg.startswith("/") else Path.home() / ".local/state") / APP_ID
    if create:
        d.parent.mkdir(parents=True, exist_ok=True)
        try:
            os.mkdir(d, 0o700)
        except FileExistsError:
            pass
    try:
        st = os.lstat(d)
    except FileNotFoundError:
        return None
    if not stat.S_ISDIR(st.st_mode) or st.st_uid != os.getuid() or stat.S_IMODE(st.st_mode) & 0o077:
        raise SystemExit("unsafe state dir")
    return d

def load() -> dict | None:
    d = state_dir(False)
    if d is None:
        return None
    try:
        fd = os.open(d / "unlock.json", os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK)
    except OSError:
        return None
    with os.fdopen(fd, "rb") as fh:
        st = os.fstat(fh.fileno())
        if not stat.S_ISREG(st.st_mode) or st.st_uid != os.getuid():
            return None
        try:
            data = json.loads(fh.read(4096))
        except ValueError:
            return None
    return data if isinstance(data, dict) else None

def save(data: dict) -> None:
    d = state_dir(True)
    fd, tmp = tempfile.mkstemp(prefix=".unlock.", suffix=".tmp", dir=d)
    try:
        with os.fdopen(fd, "w") as fh:
            json.dump(data, fh, separators=(",", ":"))
            fh.flush()
            os.fsync(fh.fileno())
        os.replace(tmp, d / "unlock.json")
    except BaseException:
        try:
            os.unlink(tmp)
        except FileNotFoundError:
            pass
        raise

def session_dir() -> Path:
    rt = os.environ.get("XDG_RUNTIME_DIR", "")
    if rt.startswith("/") and os.path.isdir(rt):
        base = Path(rt) / APP_ID
        try:
            os.mkdir(base, 0o700)
        except FileExistsError:
            pass
        st = os.lstat(base)
        if stat.S_ISDIR(st.st_mode) and st.st_uid == os.getuid() and not stat.S_IMODE(st.st_mode) & 0o077:
            return base
    d = state_dir(True)
    assert d is not None
    return d

def start_session() -> str:
    token = secrets.token_hex(32)
    d = session_dir()
    fd, tmp = tempfile.mkstemp(prefix=".session.", suffix=".tmp", dir=d)
    with os.fdopen(fd, "w") as fh:
        json.dump({"h": hashlib.sha256(token.encode()).hexdigest(), "exp": time.time() + SESSION_TTL}, fh)
    os.replace(tmp, d / "session.json")
    return token

def end_session() -> None:
    try:
        os.unlink(session_dir() / "session.json")
    except FileNotFoundError:
        pass

def pam_check(user: str, password: str) -> bool:
    name = ctypes.util.find_library("pam")
    if not name:
        return False
    pam, libc = ctypes.CDLL(name), ctypes.CDLL(ctypes.util.find_library("c"))
    libc.calloc.restype, libc.calloc.argtypes = ctypes.c_void_p, [ctypes.c_size_t, ctypes.c_size_t]
    libc.strdup.restype, libc.strdup.argtypes = ctypes.c_void_p, [ctypes.c_char_p]

    class Msg(ctypes.Structure):
        _fields_ = [("style", ctypes.c_int), ("msg", ctypes.c_char_p)]

    class Resp(ctypes.Structure):
        _fields_ = [("resp", ctypes.c_void_p), ("retcode", ctypes.c_int)]

    Conv = ctypes.CFUNCTYPE(ctypes.c_int, ctypes.c_int, ctypes.POINTER(ctypes.POINTER(Msg)),
                            ctypes.POINTER(ctypes.POINTER(Resp)), ctypes.c_void_p)

    class PamConv(ctypes.Structure):
        _fields_ = [("conv", Conv), ("data", ctypes.c_void_p)]

    pw = password.encode()

    def conv(n, msgs, out, _data):
        arr = libc.calloc(n, ctypes.sizeof(Resp))
        if not arr:
            return 5
        resp = ctypes.cast(arr, ctypes.POINTER(Resp))
        for i in range(n):
            if msgs[i].contents.style in (1, 2):
                resp[i].resp = libc.strdup(pw)
        out[0] = resp
        return 0

    cb = Conv(conv)
    pam.pam_start.argtypes = [ctypes.c_char_p, ctypes.c_char_p, ctypes.POINTER(PamConv),
                              ctypes.POINTER(ctypes.c_void_p)]
    pam.pam_authenticate.argtypes = [ctypes.c_void_p, ctypes.c_int]
    pam.pam_end.argtypes = [ctypes.c_void_p, ctypes.c_int]
    handle = ctypes.c_void_p()
    conv_s = PamConv(cb, None)
    if pam.pam_start(PAM_SERVICE.encode(), user.encode(), ctypes.byref(conv_s), ctypes.byref(handle)) != 0:
        return False
    rc = pam.pam_authenticate(handle, 0)
    pam.pam_end(handle, rc)
    return rc == 0

def kdf(code: str, salt: bytes) -> bytes:
    return hashlib.scrypt(code.encode(), salt=salt, n=N, r=R, p=P, maxmem=64 * 1024 * 1024, dklen=32)

def main() -> int:
    cmd = sys.argv[1] if len(sys.argv) == 2 else ""
    cur = load()
    if cmd == "status":
        print("set" if cur and "salt" in cur and "hash" in cur else "none")
        return 0
    if cmd == "lock":
        end_session()
        return 0
    code = sys.stdin.buffer.read(MAX_LEN * 4 + 1).decode("utf-8", "ignore").rstrip("\r\n")
    if cmd == "create":
        if cur and "hash" in cur:
            print("exists")
            return 1
        if not (MIN_LEN <= len(code) <= MAX_LEN):
            print("invalid")
            return 1
        salt = secrets.token_bytes(16)
        save({"v": 1, "n": N, "r": R, "p": P, "salt": salt.hex(), "hash": kdf(code, salt).hex(),
              "fails": 0, "until": 0})
        print("ok " + start_session())
        return 0
    if cmd == "verify":
        if not cur or "hash" not in cur:
            print("none")
            return 1
        now = time.time()
        if now < float(cur.get("until", 0)):
            print(f"wait {int(cur['until'] - now) + 1}")
            return 1
        try:
            good = hmac.compare_digest(kdf(code, bytes.fromhex(cur["salt"])), bytes.fromhex(cur["hash"]))
        except (ValueError, KeyError):
            print("none")
            return 1
        if good:
            cur["fails"], cur["until"] = 0, 0
            save(cur)
            print("ok " + start_session())
            return 0
        fails = int(cur.get("fails", 0)) + 1
        cur["fails"] = fails
        wait = DELAYS[min(fails - 5, len(DELAYS) - 1)] if fails >= 5 else 0
        cur["until"] = now + wait
        save(cur)
        print(f"wait {wait}" if wait else "bad")
        return 1
    if cmd == "reset":
        if not cur or "hash" not in cur:
            print("none")
            return 1
        now = time.time()
        if now < float(cur.get("puntil", 0)):
            print(f"wait {int(cur['puntil'] - now) + 1}")
            return 1
        import getpass
        if code and pam_check(getpass.getuser(), code):
            end_session()
            d = state_dir(False)
            if d is not None:
                try:
                    os.unlink(d / "unlock.json")
                except FileNotFoundError:
                    pass
            print("reset")
            return 0
        fails = int(cur.get("pfails", 0)) + 1
        cur["pfails"] = fails
        wait = DELAYS[min(fails - 5, len(DELAYS) - 1)] if fails >= 5 else 0
        cur["puntil"] = now + wait
        save(cur)
        print(f"wait {wait}" if wait else "bad")
        return 1
    print("usage: protonauth-unlock status|create|verify|reset|lock", file=sys.stderr)
    return 2

if __name__ == "__main__":
    sys.exit(main())
